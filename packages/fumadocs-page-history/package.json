{
  "name": "fumadocs-page-history",
  "version": "0.4.1",
  "description": "Page Git history integration for Fumadocs",
  "keywords": [
    "changelog",
    "fumadocs",
    "git",
    "react"
  ],
  "homepage": "https://github.com/shenxianovo/fumadocs-page-history",
  "bugs": {
    "url": "https://github.com/shenxianovo/fumadocs-page-history/issues"
  },
  "license": "MIT",
  "author": "shenxianovo",
  "repository": {
    "type": "git",
    "url": "https://github.com/shenxianovo/fumadocs-page-history.git",
    "directory": "packages/fumadocs-page-history"
  },
  "files": [
    "dist",
    "css",
    "NOTICE",
    "LICENSE"
  ],
  "type": "module",
  "sideEffects": [
    "./css/**/*.css"
  ],
  "exports": {
    ".": "./dist/index.js",
    "./git": "./dist/git/index.js",
    "./workspace": "./dist/workspace/index.js",
    "./ui": "./dist/ui/index.js",
    "./i18n": "./dist/i18n/index.js",
    "./css/*": "./css/*",
    "./package.json": "./package.json",
    "./remark": "./dist/remark.js",
    "./satteri": "./dist/satteri.js",
    "./schema": "./dist/schema.js"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "clean": "rimraf dist",
    "dev": "tsdown --watch --clean false",
    "lint": "oxlint .",
    "types:check": "tsc --noEmit",
    "prepack": "pnpm build"
  },
  "dependencies": {
    "@fuma-translate/react": "^1.0.2",
    "@types/mdast": "^4.0.4",
    "diff": "^9.0.0",
    "estree-util-value-to-estree": "^3.5.0",
    "github-slugger": "^2.0.0",
    "lucide-react": "^1.50.0",
    "mdast-util-mdx": "^3.0.0",
    "mdast-util-to-string": "^4.0.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "tinyexec": "^1.3.1",
    "unified": "^11.0.5",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@fumadocs/satteri": "^0.6.0",
    "@mdx-js/mdx": "^3.1.1",
    "@types/node": "26.6.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "fuma-translate": "^1.0.2",
    "fumadocs-core": "^16.17.1",
    "fumadocs-ui": "npm:@fumadocs/base-ui@^16.17.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "satteri": "^0.10.5",
    "tsdown": "0.23.0",
    "vfile": "^6.0.3",
    "vitest": "^5.0.3"
  },
  "peerDependencies": {
    "fumadocs-core": "^16.17.0",
    "fumadocs-ui": "^16.17.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "satteri": "^0.10.5"
  },
  "peerDependenciesMeta": {
    "satteri": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=24.14.0"
  }
}
